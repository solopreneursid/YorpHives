{
  "id": "/quickpanel/",
  "name": "YorpHives QuickPanel",
  "short_name": "QuickPanel",
  "description": "A private, installable workspace for everyday browser actions.",
  "start_url": "/quickpanel/",
  "scope": "/quickpanel/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui", "browser"],
  "orientation": "any",
  "theme_color": "#10111a",
  "background_color": "#0a0b10",
  "categories": ["productivity", "utilities"],
  "icons": [
    {
      "src": "/quickpanel/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    }
  ]
}