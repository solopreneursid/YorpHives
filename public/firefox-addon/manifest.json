{
  "manifest_version": 3,
  "name": "YorpHives QuickPanel",
  "version": "1.1.0",
  "description": "Local-first text tools, page capture, reusable snippets and user-invoked form assistance for Firefox.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "action": {
    "default_title": "YorpHives QuickPanel",
    "default_popup": "popup.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "quickpanel@yorphives.hatchable.site",
      "strict_min_version": "128.0"
    },
    "gecko_android": {
      "strict_min_version": "128.0"
    }
  }
}